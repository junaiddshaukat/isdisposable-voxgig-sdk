# Entity: check

main: kit: entity: check: {

  alias: field: {}

  fields: {
    cached: {
      h: "Cached"
      n: "cached"
      r: false
      t: "`$BOOLEAN`"
    }
    disposable: {
      h: "Disposable"
      n: "disposable"
      r: false
      t: "`$BOOLEAN`"
    }
    domain: {
      h: "Domain"
      n: "domain"
      r: false
      t: "`$STRING`"
    }
    domain_age_days: {
      h: "Domain Age Days"
      n: "domain_age_days"
      r: false
      t: "`$INTEGER`"
    }
    email: {
      h: "Email"
      n: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The email address to check."
      t: "`$STRING`"
    }
    error: {
      h: "Error"
      n: "error"
      r: false
      sh: "Set on a bulk result item that could not be checked."
      t: "`$STRING`"
    }
    mx_valid: {
      h: "Mx Valid"
      n: "mx_valid"
      r: false
      t: "`$BOOLEAN`"
    }
    reason: {
      h: "Reason"
