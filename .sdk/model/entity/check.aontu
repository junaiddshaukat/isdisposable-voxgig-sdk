      t: "`$STRING`"
    }
    score: {
      h: "Score"
      n: "score"
      r: false
      sh: "Risk score from 0 (safe) to 100 (definitely disposable)."
      t: "`$INTEGER`"
    }
  }

  name: "check"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/check"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/check"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "check"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



