          url: "https://isdisposable.com/api"
        }
      ]
      summary: "Real-time disposable email detection with DNS/MX checks, risk scoring and domain age."
      title: "isDisposable API"
      version: "1.0.0"
      website: "https://isdisposable.com"
    }
  }
